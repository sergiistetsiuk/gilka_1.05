# GILKA local configuration. Copy this file to .env and fill in private values.
# PlatformIO loads firmware defaults from this file at build time.
# Values saved on the device in NVS take precedence, including empty API keys.
# Shell usage for upload commands: set -a; source .env; set +a

# Local build / USB connection
PIO_ENV=esp32-s3-zero
UPLOAD_PORT=/dev/cu.usbmodem2101
MONITOR_BAUD=115200

# Device web address on your LAN (use its IP if mDNS is unavailable)
DEVICE_URL=http://gilka.local

# Firmware defaults: rebuild/upload after editing; existing NVS values take priority
WIFI_SSID=""
WIFI_PASSWORD=""
OPENWEATHERMAP_API_KEY=""
DEVICE_TIMEZONE="EET-2EEST,M3.5.0/3,M10.5.0/4"

# OTA: copy the temporary password/IP displayed on the OLED when OTA is armed
OTA_HOST=""
OTA_PORT=3232
OTA_PASSWORD=""

# SaveEcoBot read API (access key required)
SAVEECOBOT_API_KEY=""
SAVEECOBOT_STATION="Cherkasy, Cherkasy Oblast"
SAVEECOBOT_RADIUS_KM=25
SAVEECOBOT_PUBLIC_JSON_URL="https://www.saveecobot.com/en/station/22800.json"

# Ukraine Alarm (Stfalcon), token is sent without Bearer prefix
UKRAINEALARM_API_KEY=""
UKRAINEALARM_REGION_NAME="Черкаська область"
